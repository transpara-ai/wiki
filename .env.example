# Copy to .env; keep the real file private. Match the checkout owner's IDs.
WIKI_UID=1000
WIKI_GID=1000
WIKI_PORT=8787
# Host directory containing wiki and its sibling source repositories.
WIKI_REPOS_DIR=/Transpara/transpara-ai/repos
# Generate with: openssl rand -hex 32
KNOWLEDGE_HUB_AUTHORING_TOKEN=
# Add the actual Tailscale DNS name, without a scheme or trailing dot.
KNOWLEDGE_HUB_ALLOWED_HOSTS=localhost,127.0.0.1
KNOWLEDGE_HUB_REFRESH_SECONDS=900
