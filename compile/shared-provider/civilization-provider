#!/usr/bin/env python3
"""Run an approved provider CLI through Civilization's persistent identity boundary."""

from __future__ import annotations

import json
import os
from pathlib import Path
import subprocess
import sys


CONTAINER = "transpara-shared-provider"
DOCKER = "/usr/bin/docker"
OBSERVATION = Path('/Transpara/transpara-ai/deployments/shared-provider-velia/state/provider-auth.json')


def run(arguments: list[str]) -> int:
    environment = os.environ.copy()
    environment.setdefault("DOCKER_HOST", "unix:///var/run/docker.sock")
    # Optional deadline inside the container; docker exec termination alone
    # does not stop the model process. Existing callers are unchanged.
    deadline = environment.pop("CIVILIZATION_PROVIDER_TIMEOUT_SECONDS", "")
    if deadline and arguments[:2] == ["exec", "-i"]:
        seconds = int(deadline)
        if not 1 <= seconds <= 240:
            raise ValueError("provider deadline must be between 1 and 240 seconds")
        # Keep native login/status calls unchanged. Bounded inference gets a
        # private working directory inside the container, removed on exit.
        isolated = ('umask 077; request_dir=$(mktemp -d /tmp/provider-request.XXXXXX) || exit 1; '
                    'trap \'rm -rf "$request_dir"\' EXIT; '
                    'cd "$request_dir" || exit 1; limit=$1; shift; '
                    'timeout --signal=TERM --kill-after=5s "$limit" "$@"')
        arguments = [*arguments[:3], "sh", "-c", isolated,
                     "provider-request", str(seconds), *arguments[3:]]
    prefix = [] if os.geteuid() == 0 else ['sudo', '-n']
    return subprocess.run([*prefix, DOCKER, *arguments], env=environment).returncode


def usage() -> int:
    print(
        "usage: civilization-provider status | "
        "civilization-provider claude [args...] | "
        "civilization-provider codex [args...]",
        file=sys.stderr,
    )
    return 2


def main() -> int:
    if len(sys.argv) < 2:
        return usage()
    provider, arguments = sys.argv[1], sys.argv[2:]
    if provider == "status":
        if arguments:
            return usage()
        document = json.loads(OBSERVATION.read_text())
        print(json.dumps(document, indent=2, sort_keys=True))
        return 0 if document.get("healthy") is True else 1
    if provider == "codex":
        return run(["exec", "-i", CONTAINER, "codex", *arguments])
    if provider == "claude":
        # Docker exec does not inherit variables exported by container PID 1.
        # Load the long-lived OAuth token inside the container from its secret;
        # never pass it through argv, Compose configuration, or host output.
        return run(
            [
                "exec",
                "-i",
                CONTAINER,
                "sh",
                "-ec",
                'export CLAUDE_CODE_OAUTH_TOKEN="$(cat /run/secrets/claude_oauth_token)"; '
                'exec claude "$@"',
                "claude",
                *arguments,
            ]
        )
    return usage()


if __name__ == "__main__":
    sys.exit(main())
